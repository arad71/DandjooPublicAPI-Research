upstream authz_web {
    server authz-prod-service.bio-prod:${AUTHZ_PORT};   #8010
}

upstream public_api {
    server dandjoo-prod-public-api-service.bio-prod:${API_PORT};     #8000
}

upstream curation_api {
    server dandjoo-prod-curation-api-service.bio-prod:${CURATION_API_PORT};     #8090
}

upstream geoserver {
    server dandjoo-prod-geoserver-service.bio-prod:${GEOSERVER_PORT};   #8080
}

